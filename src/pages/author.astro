---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { fmtDate, slugify } from '../utils';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const latest = posts;
const catCount = new Set(posts.map((p) => p.data.category)).size;

const desc = 'Talha Mehmood is the founder and writer of Talha M Blog — an independent publisher from Pakistan who explains big news, AI tools and entertainment in simple English.';
const personLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  mainEntity: {
    '@type': 'Person',
    name: 'Talha Mehmood',
    jobTitle: 'Founder & Writer',
    description: desc,
    url: new URL('/author/', Astro.site).toString(),
    image: new URL('/images/talha-mehmood.webp', Astro.site).toString(),
    email: 'mailto:lartkapagal@gmail.com',
    sameAs: ['https://www.instagram.com/talh_ablog/'],
    worksFor: { '@type': 'Organization', name: 'Talha M Blog', url: new URL('/', Astro.site).toString() },
  },
});
---

<Base title="Talha Mehmood" description={desc} extraLd={personLd}>
  <section class="auth-hero">
    <img class="auth-avatar-img" src="/images/talha-mehmood.webp" alt="Talha Mehmood" width="600" height="600" />
    <div class="auth-plane" aria-hidden="true">✈️<span class="auth-smoke"></span></div>
    <h1>Talha Mehmood</h1>
    <p class="auth-role">Founder &amp; Writer</p>
    <p class="auth-bio">Talha Mehmood is an independent publisher from Pakistan. He runs Talha M Blog, where big news, AI tools and entertainment stories are explained in simple English that everyone can understand.</p>
    <div class="auth-btns">
      <a class="auth-btn-insta" href="https://www.instagram.com/talh_ablog/" target="_blank" rel="noopener noreferrer"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1.2" fill="currentColor" stroke="none"/></svg>Instagram</a>
      <a class="auth-btn-mail" href="mailto:lartkapagal@gmail.com" aria-label="Email"><svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path fill="#4285F4" d="M3.5 8.8 6.3 11v9.5H3.5z"/><path fill="#34A853" d="M20.5 8.8 17.7 11v9.5h2.8z"/><path fill="#EA4335" d="M3.5 5.4v3.4L12 15v-3.5z"/><path fill="#FBBC04" d="M20.5 5.4v3.4L12 15v-3.5z"/></svg></a>
    </div>
  </section>

  <div class="auth-stats">
    <div class="auth-stat"><b>{posts.length}+</b><small>Posts</small></div>
    <div class="auth-stat"><b>{catCount}</b><small>Categories</small></div>
    <div class="auth-stat"><b>Daily</b><small>New Stories</small></div>
  </div>

  <section class="auth-list">
    <h2>All posts by Talha Mehmood</h2>
    {latest.map((post) => (
      <div class="auth-row">
        <a class="auth-cat" href={`/category/${slugify(post.data.category)}/`}>{post.data.category}</a>
        <a class="auth-title" href={`/blog/${post.id}/`}>{post.data.title}</a>
        <small>{fmtDate(post.data.pubDate)}</small>
      </div>
    ))}
  </section>
</Base>

<style>
  .auth-hero { text-align: center; padding: 1.6rem 0 1.4rem; }
  .auth-avatar-img { width: 110px; height: 110px; border-radius: 50%; object-fit: cover; display: block; margin: 0 auto 12px; border: 4px solid #ffb020; position: relative; z-index: 5; animation: picJourney 4.2s ease 0.3s both; }
  @keyframes picJourney { 0% { transform: translateY(0); opacity: 1; } 25% { transform: translateY(68vh); opacity: 0; } 62% { transform: translateY(-18px); opacity: 0; } 71% { transform: translateY(0); opacity: 1; } 79% { transform: translateY(-5px); opacity: 1; } 87%, 100% { transform: translateY(0); opacity: 1; } }
  .auth-plane { position: fixed; left: 50%; bottom: -90px; margin-left: -26px; font-size: 60px; line-height: 1; z-index: 999; opacity: 0; pointer-events: none; animation: planeFly 2.3s linear 1.25s both; }
  .auth-smoke { position: absolute; left: 50%; top: 85%; width: 12px; height: 120px; margin-left: -6px; background: linear-gradient(rgba(170, 170, 170, 0.5), rgba(170, 170, 170, 0)); filter: blur(4px); border-radius: 50%; transform: rotate(45deg); transform-origin: top center; }
  @keyframes planeFly { 0% { opacity: 0; transform: translateY(0) rotate(-45deg); } 8% { opacity: 1; } 88% { opacity: 1; } 100% { opacity: 0; transform: translateY(-118vh) rotate(-45deg); } }
  .auth-hero h1 { font-family: var(--serif); font-size: 1.35rem; font-weight: 700; letter-spacing: 0.5px; margin: 0; }
  .auth-role { color: #1d4ed8; font-weight: bold; font-size: 0.9rem; margin: 0.35rem 0 0.8rem; }
  .auth-bio { font-size: 1rem; line-height: 1.65; margin: 0 auto 1.1rem; text-align: justify; }
  .auth-btns { display: flex; gap: 14px; justify-content: center; margin: 0 auto; }
  .auth-btns a { flex: none; width: 46px; height: 46px; display: flex; align-items: center; justify-content: center; padding: 0; border-radius: 50%; font-size: 0; text-decoration: none; }
  .auth-btn-insta { background: linear-gradient(45deg, #f09433 0%, #e6683c 25%, #dc2743 50%, #cc2366 75%, #bc1888 100%); color: #fff; }
  .auth-btn-mail { background: #fff; border: 2px solid #e2e6ef; color: #333; }
  .auth-stats { display: flex; gap: 10px; margin: 0.4rem 0 0; }
  .auth-stat { flex: 1; border: 1px solid #e2e6ef; border-radius: 10px; padding: 12px 4px; text-align: center; background: #fff; animation: statBob 3.6s ease-in-out infinite; }
  .auth-stat:nth-child(2) { animation-delay: 0.4s; }
  .auth-stat:nth-child(3) { animation-delay: 0.8s; }
  @keyframes statBob { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-4px); } }
  .auth-stat b { display: block; font-size: 1.25rem; background: linear-gradient(90deg, #1d4ed8, #9333ea, #1d4ed8); background-size: 200% auto; -webkit-background-clip: text; background-clip: text; color: transparent; animation: statShine 3s linear infinite; }
  @keyframes statShine { to { background-position: 200% center; } }
  .auth-stat small { color: #555; font-size: 0.85rem; }
  .auth-list { padding: 1.4rem 0 0.6rem; }
  .auth-list h2 { font-family: var(--serif); font-size: 1.25rem; color: #12275e; text-align: center; background: #fff; border: 1px solid #e2e6ef; border-radius: 0; box-shadow: 0 2px 10px rgba(18, 39, 94, 0.08); padding: 12px 10px; margin: 0 0 12px; }
  .auth-row { background: #fff; border: 1px solid #e2e6ef; border-radius: 14px; box-shadow: 0 2px 10px rgba(18, 39, 94, 0.08); padding: 14px 16px; margin-bottom: 12px; }
  .auth-row:last-child { margin-bottom: 0; }
  .auth-cat { display: inline-block; background: linear-gradient(135deg, #1d4ed8, #12275e); color: #fff; font-size: 0.65rem; font-weight: bold; letter-spacing: 0.6px; text-transform: uppercase; text-decoration: none; padding: 3px 10px; border-radius: 4px; }
  .auth-title { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; font-family: var(--serif); font-size: 1.12rem; font-weight: bold; color: #12275e; text-decoration: none; margin: 6px 0 2px; }
  .auth-row small { color: #777; }
</style>