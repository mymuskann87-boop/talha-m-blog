---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostRow from '../../components/PostRow.astro';
import { slugify } from '../../utils';

export async function getStaticPaths() {
  const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
  );
  const names = [...new Set(posts.map((p) => p.data.category))];
  return names.map((name) => ({
    params: { cat: slugify(name) },
    props: { name, posts: posts.filter((p) => p.data.category === name) },
  }));
}

const { name, posts } = Astro.props;
---

<Base title={name} description={`Latest ${name} posts`}>
  <section class="intro"><h1>{name}</h1></section>
  {posts.map((post) => <PostRow post={post} />)}
</Base>
