---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostRow from '../../components/PostRow.astro';
import { slugify } from '../../utils';

export async function getStaticPaths() {
  const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
  );
  const names = [...new Set(posts.map((p) => p.data.category))];
  return names.map((name) => ({
    params: { cat: slugify(name) },
    props: { name, posts: posts.filter((p) => p.data.category === name) },
  }));
}

const { name, posts } = Astro.props;
const DESCRIPTIONS: Record<string, string> = {
  AI: 'Latest AI news, new AI tools and coding agents, explained step by step in simple English.',
  'Pakistan News': 'Latest Pakistan news: politics, government and daily events, explained step by step in simple English.',
  'US News': 'Important news from the United States, explained step by step in simple English.',
  Celebrity: 'Celebrity news and life stories of famous people, explained in simple English.',
  Nature: 'Stories about the natural world: forests, rivers, animals and the planet, explained in simple English.',
  Business: 'Big business stories: companies, money and markets, explained in simple English.',
  Conflict: 'Wars, attacks and tensions around the world, explained clearly in simple English.',
  Crime: 'Crime stories and court cases from around the world, explained in simple English.',
  Disasters: 'Earthquakes, storms, floods and other disasters, explained clearly in simple English.',
  Awards: 'Big awards and honours from around the world, explained in simple English.',
  Politics: 'Elections, governments and big political decisions, explained in simple English.',
  Health: 'Health news and medical stories that matter, explained in simple English.',
  Space: 'Space missions, rockets and discoveries beyond Earth, explained in simple English.',
};
const desc = DESCRIPTIONS[name] || `Latest ${name} posts on Talha M Blog, explained step by step in simple English.`;
const catLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name,
  description: desc,
  url: new URL(Astro.url.pathname, Astro.site).toString(),
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: posts.slice(0, 20).map((p, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: new URL(`/blog/${p.id}/`, Astro.site).toString(),
      name: p.data.title,
    })),
  },
});
---

<Base title={name} description={desc} extraLd={catLd}>
  <nav class="crumbs" aria-label="Breadcrumb">
    <a href="/">Home</a> <span aria-hidden="true">›</span>
    <span class="crumb-here">{name}</span>
  </nav>
  <section class="intro"><h1>{name}</h1></section>
  {posts.map((post) => <PostRow post={post} />)}
</Base>

<style>
  .crumbs { font-size: 0.85rem; margin: 0 0 0.9rem; opacity: 0.85; display: flex; flex-wrap: wrap; gap: 0.35rem; align-items: baseline; }
  .crumbs a { text-decoration: none; font-weight: 600; }
  .crumbs a:hover { text-decoration: underline; }
  .crumb-here { opacity: 0.75; }
</style>
