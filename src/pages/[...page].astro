---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PostRow from '../components/PostRow.astro';

export const getStaticPaths = (async ({ paginate }) => {
  const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
  );
  return paginate(posts, { pageSize: 10 });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const first = page.currentPage === 1;

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const catMap = new Map();
for (const p of allPosts) {
  const name = String(p.data.category || '').trim();
  if (!name) continue;
  const slug = name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
  if (slug && !catMap.has(slug)) catMap.set(slug, name);
}
const cats = [...catMap].map(([slug, name]) => ({ slug, name }));
---

<Base
  title={first ? 'News, AI Tools and Entertainment in Simple English' : undefined}
  description={first ? 'Daily news on Pakistan, world events, AI tools and entertainment, explained step by step in simple English that anyone can follow.' : undefined}
>
  {first && (
    <section class="intro">
      <h1 id="welcome-title">Welcome to Talha M Blog</h1><script is:inline>(function(){var h=document.getElementById('welcome-title');if(!h)return;try{if(sessionStorage.getItem('welcomeTyped'))return;sessionStorage.setItem('welcomeTyped','1');}catch(e){return;}var t=h.textContent;h.style.minHeight=h.offsetHeight+'px';h.textContent='';var i=0;(function type(){h.textContent=t.slice(0,++i);if(i<t.length)setTimeout(type,80);})();})();</script>
      <p>
        Daily news on world events, sports, celebrities and AI tools — every story in simple
        English that anyone can follow.
      </p>
    </section>
  )}

  {first && (
    <nav class="cat-boxes" aria-label="Categories">
      {cats.map((c) => <a href={`/category/${c.slug}/`}>{c.name}</a>)}
    </nav>
  )}

  {page.data.length === 0 && <p class="empty">No posts yet. Add your first post in src/content/blog.</p>}

  {page.data.map((post, i) => <PostRow post={post} big={first && i === 0} />)}

  {(page.url.prev || page.url.next) && (
    <nav class="pager" aria-label="Pages">
      {page.url.prev ? <a href={page.url.prev}>Newer posts</a> : <span />}
      {page.url.next ? <a href={page.url.next}>Older posts</a> : <span />}
    </nav>
  )}
</Base>

<style>
  .cat-boxes { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.45rem; margin: 0.35rem 0 1.5rem; }
  .cat-boxes a { display: flex; align-items: center; justify-content: center; text-align: center; padding: 0.42rem 0.25rem; border: 1px solid color-mix(in srgb, currentColor 25%, transparent); border-radius: 6px; text-decoration: none; font-weight: 600; font-size: 0.8rem; line-height: 1.3; }
  .cat-boxes a:hover { background: color-mix(in srgb, currentColor 8%, transparent); }
</style>