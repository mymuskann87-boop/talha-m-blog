---
import type { CollectionEntry } from 'astro:content';
import { fmtDate, readingTime, slugify } from '../utils';

interface Props {
  post: CollectionEntry<'blog'>;
  big?: boolean;
}
const { post, big = false } = Astro.props;
const d = post.data;
const pubTime = d.pubDate.toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit', timeZone: 'Asia/Karachi' });
---

<article class:list={['row', { big }]}>
  {d.image && <a href={`/blog/${post.id}/`}><img class="row-img" src={d.image} alt={d.imageAlt || d.title} width="1200" height="630" loading={big ? "eager" : "lazy"} fetchpriority={big ? "high" : undefined} decoding="async" /></a>}
  <a class="cat" href={`/category/${slugify(d.category)}/`}>{d.category}</a>
  <h2><a href={`/blog/${post.id}/`}>{d.title}</a></h2>
  <p class="desc">{d.description}</p>
  <p class="meta">
    <span class="live-dot" data-pub={d.pubDate.toISOString()} aria-hidden="true"></span>
    <time datetime={d.pubDate.toISOString()}>{fmtDate(d.pubDate)}</time>
    <span>{pubTime} PKT</span>
    <span>{readingTime(post.body)} min read</span>
  </p>
</article>

<style>
  .row-img { width: 100%; height: auto; border-radius: 10px; margin-bottom: 0.75rem; }
  .live-dot { display: inline-block; width: 9px; height: 9px; border-radius: 50%; background: #9ca3af; margin-right: 6px; vertical-align: middle; }
  .live-dot.on { background: #22c55e; box-shadow: 0 0 0 3px rgba(34, 197, 94, 0.25); }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.live-dot').forEach((el) => {
    const age = Date.now() - new Date(el.dataset.pub || '').getTime();
    const fresh = age < 48 * 3600 * 1000;
    el.classList.add(fresh ? 'on' : 'off');
    el.title = fresh ? 'New' : '';
  });
</script>
